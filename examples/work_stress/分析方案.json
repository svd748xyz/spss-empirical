{
  "title": "工作压力、心理资本与职业倦怠的实证分析",
  "data_file": "data.csv",
  "methods_note": "数据为 220 行模拟问卷。性别编码为 0=男、1=女，年级以 1 至 4 的原编码进入回归，未设置虚拟变量。文件里原有的工作压力、心理资本、职业倦怠与题项均值并不完全相同，因此在 SPSS 中按题项重新计算均值后再进行分析。没有反向题，也不因极端值删除个案。本机未安装 Hayes PROCESS，中介效应只报告路径系数和 Sobel 检验。",
  "variables": [
    {"name": "性别", "label": "性别", "values": {"0": "男", "1": "女"}},
    {"name": "年级", "label": "年级"},
    {"name": "工作压力", "label": "工作压力"},
    {"name": "心理资本", "label": "心理资本"},
    {"name": "职业倦怠", "label": "职业倦怠"}
  ],
  "scales": [
    {"name": "工作压力", "label": "工作压力", "items": ["压力1", "压力2", "压力3", "压力4"]},
    {"name": "心理资本", "label": "心理资本", "items": ["资本1", "资本2", "资本3", "资本4"]},
    {"name": "职业倦怠", "label": "职业倦怠", "items": ["倦怠1", "倦怠2", "倦怠3", "倦怠4"]}
  ],
  "analyses": [
    {"type": "zscreen", "vars": ["工作压力", "心理资本", "职业倦怠"]},
    {"type": "frequencies", "vars": ["性别", "年级"]},
    {"type": "descriptives", "vars": ["工作压力", "心理资本", "职业倦怠"]},
    {"type": "reliability", "scale": "工作压力", "items": ["压力1", "压力2", "压力3", "压力4"]},
    {"type": "reliability", "scale": "心理资本", "items": ["资本1", "资本2", "资本3", "资本4"]},
    {"type": "reliability", "scale": "职业倦怠", "items": ["倦怠1", "倦怠2", "倦怠3", "倦怠4"]},
    {"type": "efa", "items": ["压力1", "压力2", "压力3", "压力4", "资本1", "资本2", "资本3", "资本4", "倦怠1", "倦怠2", "倦怠3", "倦怠4"]},
    {"type": "harman", "items": ["压力1", "压力2", "压力3", "压力4", "资本1", "资本2", "资本3", "资本4", "倦怠1", "倦怠2", "倦怠3", "倦怠4"]},
    {"type": "correlation", "vars": ["工作压力", "心理资本", "职业倦怠"]},
    {"type": "ttest", "group": "性别", "codes": [0, 1], "outcomes": ["职业倦怠"]},
    {"type": "anova", "factor": "年级", "outcomes": ["职业倦怠"]},
    {
      "type": "regression",
      "dependent": "职业倦怠",
      "blocks": [
        ["性别", "年级"],
        ["性别", "年级", "工作压力"],
        ["性别", "年级", "工作压力", "心理资本"]
      ]
    },
    {"type": "mediation", "x": "工作压力", "m": "心理资本", "y": "职业倦怠", "controls": ["性别", "年级"]}
  ]
}
